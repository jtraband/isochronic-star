# Copy to .env.local and fill in the engines you want. Keys typed into the app's
# sidebar override these.

# TomTom: https://developer.tomtom.com/ (live + typical traffic)
VITE_TOMTOM_KEY=
# HERE: https://platform.here.com/ (live + typical traffic)
VITE_HERE_KEY=
# Mapbox: https://account.mapbox.com/ (traffic; max 60 min and 4 rings)
VITE_MAPBOX_TOKEN=
# TravelTime: https://traveltime.com/ (time-of-day traffic; needs both values)
VITE_TRAVELTIME_APP_ID=
VITE_TRAVELTIME_KEY=
# openrouteservice: https://openrouteservice.org/dev/#/signup (no traffic; max 60 min)
VITE_ORS_KEY=

# Optional: your own OSRM server (defaults to the public demo server).
VITE_OSRM_URL=https://router.project-osrm.org
